{
  "productName": "Sutrata",
  "version": "0.1.0",
  "identifier": "com.sutrata.app",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "pnpm --filter @sutrata/app build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../app/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
