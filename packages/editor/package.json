{
  "name": "@sutrata/editor",
  "version": "0.5.0",
  "description": "React + ProseMirror screenplay editor for Sutra, with first-class support for Indic and other complex scripts.",
  "license": "GPL-3.0-or-later",
  "keywords": [
    "sutra",
    "screenplay",
    "editor",
    "prosemirror",
    "react",
    "indic",
    "unicode",
    "fountain"
  ],
  "homepage": "https://github.com/sutrata/sutrata/tree/main/packages/editor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sutrata/sutrata.git",
    "directory": "packages/editor"
  },
  "bugs": {
    "url": "https://github.com/sutrata/sutrata/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "scripts/fetch-dictionaries.mjs"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc && node scripts/copy-assets.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.1",
    "@lezer/highlight": "^1.2.3",
    "@sutrata/parser": "workspace:*",
    "diff": "^9.0.0",
    "docx": "^9.7.1",
    "emscripten-wasm-loader": "3.0.3",
    "hunspell-asm": "4.0.2",
    "jszip": "^3.10.1",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-history": "^1.5.0",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-schema-basic": "^1.2.4",
    "prosemirror-state": "^1.4.4",
    "prosemirror-transform": "^1.12.0",
    "prosemirror-view": "^1.42.6"
  },
  "peerDependencies": {
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "fast-check": "^4.10.2",
    "jsdom": "^29.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.6"
  }
}
